    "dev:socket": "tsx watch socket-server/index.ts",
    "build": "next build",
    "start": "concurrently -n next,socket -c blue,green \"next start\" \"npm:start:socket\"",
    "start:socket": "tsx socket-server/index.ts",
    "lint": "eslint"
  },
  "dependencies": {
